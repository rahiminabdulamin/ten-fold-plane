(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/copilotkit/* copilot:8200

	# Grist's fingerprinted UI assets contain no document data and must load before
	# either the private editor or a capability-gated public form can render.
	@grist_static path /grist/custom.css /grist/v/* /grist/icons/* /grist/locales/* /grist/favicon*
	handle @grist_static {
		uri strip_prefix /grist
		reverse_proxy grist:8484
	}

	# Grist opens form previews at its canonical document URL rather than below
	# /grist. Keep previews private and pass the signed-in editor identity through.
	@grist_form_preview path_regexp grist_form_preview ^/[A-Za-z0-9_-]{12,}/[^/]+/f/[0-9]+(?:/.*)?$
	handle @grist_form_preview {
		vars grist_original_uri {uri}
		forward_auth api:8000 {
			uri /api/v1/internal/grist/authorize/
			header_up X-Ten-Fold-Original-Uri {vars.grist_original_uri}
			copy_headers X-Ten-Fold-User X-Ten-Fold-Name
		}
		reverse_proxy grist:8484
	}

	# Grist's /api/s namespace is authorized by its unguessable share key and is
	# used to load, submit, and upload attachments for published forms.
	@grist_shared_api path /o/ten-fold/api/s/*
	handle @grist_shared_api {
		reverse_proxy grist:8484 {
			header_up -X-Ten-Fold-User
			header_up -X-Ten-Fold-Name
		}
	}

	@grist_editor path /grist/* /o/ten-fold /o/ten-fold/* /dw/self/*
	handle @grist_editor {
		vars grist_original_uri {uri}
		forward_auth api:8000 {
			uri /api/v1/internal/grist/authorize/
			header_up X-Ten-Fold-Original-Uri {vars.grist_original_uri}
			copy_headers X-Ten-Fold-User X-Ten-Fold-Name
		}
		uri strip_prefix /grist
		reverse_proxy grist:8484
	}

	handle /grist-public/forms/* {
		vars grist_original_uri {uri}
		forward_auth api:8000 {
			uri /api/v1/internal/grist/authorize-form/
			header_up X-Ten-Fold-Original-Uri {vars.grist_original_uri}
		}
		uri strip_prefix /grist-public
		reverse_proxy grist:8484 {
			header_up -X-Ten-Fold-User
			header_up -X-Ten-Fold-Name
		}
	}

	# Native Grist form publication URLs are capability URLs: the unguessable
	# share key grants access, so they must reach Grist without editor identity.
	@grist_native_form path_regexp grist_native_form ^/forms/[A-Za-z0-9_-]+/[0-9]+(?:/.*)?$
	handle @grist_native_form {
		reverse_proxy grist:8484 {
			header_up -X-Ten-Fold-User
			header_up -X-Ten-Fold-Name
		}
	}

	reverse_proxy /forms/* api:8000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	tls {$CADDY_TLS_CERT_FILE} {$CADDY_TLS_KEY_FILE}
	import plane_proxy
}
