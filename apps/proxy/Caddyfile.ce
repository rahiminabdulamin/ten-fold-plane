(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/copilotkit/* copilot:8200

	# Grist's fingerprinted UI assets contain no document data and must load before
	# either the private editor or a capability-gated public form can render.
	@grist_static path /grist/v/* /grist/icons/* /grist/locales/* /grist/favicon*
	handle @grist_static {
		uri strip_prefix /grist
		reverse_proxy grist:8484
	}

	handle /grist/* {
		request_header -X-Ten-Fold-User
		request_header -X-Ten-Fold-Name
		forward_auth api:8000 {
			uri /api/v1/internal/grist/authorize/
			copy_headers X-Ten-Fold-User X-Ten-Fold-Name
		}
		uri strip_prefix /grist
		reverse_proxy grist:8484
	}

	handle /grist-public/forms/* {
		forward_auth api:8000 {
			uri /api/v1/internal/grist/authorize-form/
		}
		uri strip_prefix /grist-public
		reverse_proxy grist:8484
	}

	reverse_proxy /forms/* api:8000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
